# ===========================================================================
# Albion Proxy - Environment Configuration Template
# Set these variables in Railway / production dashboard
# ===========================================================================

# --- Supabase (Auth, Vector Embeddings, Caps & Usage Ledger) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Albion Proxy Server Configuration ---
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=*
RATE_LIMIT_STORE=memory

# --- Paid AI Provider Keys ---
DEEPINFRA_API_KEY=your-deepinfra-api-key
TOGETHER_API_KEY=your-together-api-key

# --- Free Tier Cloud Providers (Rotation Pool & Fallbacks) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_API_KEY_1=your-openrouter-key-1
OPENROUTER_API_KEY_2=your-openrouter-key-2
OPENROUTER_API_KEY_3=your-openrouter-key-3
OPENROUTER_API_KEY_4=your-openrouter-key-4
OPENROUTER_API_KEY_5=your-openrouter-key-5
OPENROUTER_API_KEY_6=your-openrouter-key-6
OPENROUTER_API_KEY_7=your-openrouter-key-7
OPENROUTER_API_KEY_8=your-openrouter-key-8
OPENROUTER_FREE_MODEL=cohere/north-mini-code:free
GROQ_API_KEY=your-groq-api-key

# --- Billing Providers: Paystack ---
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_TEST_SECRET_KEY=your-paystack-test-secret-key

# --- Billing Providers: Lemon Squeezy ---
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-secret
LEMONSQUEEZY_STORE_ID=your-lemonsqueezy-store-id

# --- Error Tracking ---
SENTRY_DSN=
