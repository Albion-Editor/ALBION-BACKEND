# Albion Proxy - Environment Configuration Template
# Set these variables in Railway / production dashboard

# --- Supabase (Auth, Vector Embeddings, Caps & Usage Ledger) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Albion Proxy Server Configuration ---
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=*
RATE_LIMIT_STORE=memory

# --- Paid AI Provider Keys ---
DEEPINFRA_API_KEY=your-deepinfra-api-key
TOGETHER_API_KEY=your-together-api-key

# --- Free Tier: DeepInfra single provider, 200k lifetime tokens ---
FREE_TIER_TOKEN_CAP=200000
FREE_TIER_PROVIDER=deepinfra
DEEPINFRA_FLASH_MODEL=deepseek/deepseek-v4.1-flash-1017

# --- Billing Providers: NOWPayments (Zero-KYC Crypto Native) ---
NOWPAYMENT_API_KEY=your-nowpayments-api-key
NOWPAYMENT_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENT_PAYOUT_WALLET=your-non-custodial-payout-wallet-address
NOWPAYMENT_IPN_CALLBACK_URL=https://albion-backend-production-a88e.up.railway.app/api/webhooks/nowpayments
NOWPAYMENT_SUCCESS_URL=https://albion.dev/payment/success
NOWPAYMENT_CANCEL_URL=https://albion.dev/payment/cancel

# --- Billing Providers: Paystack (Coming Soon - Fiat) ---
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_TEST_SECRET_KEY=your-paystack-test-secret-key

# --- Error Tracking ---
SENTRY_DSN=
